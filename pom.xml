<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
      =======================================================================
      TECHNICAL SPECIFICATION - PLUGGABLE MODULE
      =======================================================================
      Project Name : pbb-collection-utilities
      Type         : Pluggable & Reusable JAR Module
      Description  : Provides lightweight, high-performance processing utility
                     methods for Java collections (without framework overhead).

      Architecture & Constraints:
      - Runtime Environment : Java 24 (Strict minimum compiler compliance)
      - Framework Policy    : Heavy frameworks (Spring Boot, Micronaut, etc.)
                              are explicitly excluded to eliminate overhead.
      - Packaging Target    : Standard pluggable JAR file for cross-project integration.

      Dependency Management & Decoupling Rationale:
      - org.junit.jupiter (api & engine) [Scope: test]
        * Purpose: Implements isolated unit testing via JUnit 5.
        * Rationale: Kept under test scope to ensure ZERO external dependencies
          are bundled into the final production JAR artifact, keeping it ultra-lightweight.
      =======================================================================
    -->
    <groupId>com.pbb.utilities</groupId>
    <artifactId>pbb-collection-utilities</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>24</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencies>
        <!-- JUnit 5 pour la suite de tests unitaires -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Configuration du compilateur pour garantir la conformité Java 24 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Plugin Surefire standardisé pour orchestrer les tests JUnit 5 en CI/CD -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
